<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AltraBWTB | Simple. Smart. Connected.</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
      background: #ffffff;
      line-height: 1.6;
    }

    /* NAVIGATION */
    header {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(255,255,255,0.96);
      box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    nav {
      max-width: 1200px;
      margin: auto;
      padding: 18px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
      color: #0757c9;
      text-decoration: none;
    }

    .logo span {
      color: #172033;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 30px;
    }

    .nav-links a {
      text-decoration: none;
      color: #172033;
      font-weight: 600;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: #0757c9;
    }

    .menu-btn {
      display: none;
      font-size: 28px;
      cursor: pointer;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      padding: 150px 25px 80px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(135deg, #eef6ff 0%, #ffffff 55%, #e9f2ff 100%);
    }

    .hero-container {
      max-width: 1200px;
      width: 100%;
      margin: auto;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 60px;
      align-items: center;
    }

    .hero h1 {
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.05;
      margin-bottom: 25px;
      color: #10254d;
    }

    .hero h1 span {
      color: #0757c9;
    }

    .hero p {
      max-width: 600px;
      font-size: 19px;
      color: #596579;
      margin-bottom: 35px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 15px 28px;
      border-radius: 30px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-primary {
      color: white;
      background: #0757c9;
      box-shadow: 0 8px 20px rgba(7,87,201,0.25);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      background: #0646a3;
    }

    .btn-secondary {
      color: #0757c9;
      border: 2px solid #0757c9;
      background: white;
    }

    .btn-secondary:hover {
      background: #0757c9;
      color: white;
    }

    /* PHONE MOCKUP */
    .phone-area {
      display: flex;
      justify-content: center;
    }

    .phone {
      width: 285px;
      height: 570px;
      border: 10px solid #101827;
      border-radius: 42px;
      background: white;
      box-shadow: 0 25px 55px rgba(0,0,0,0.2);
      overflow: hidden;
      position: relative;
    }

    .phone-top {
      height: 35px;
      background: #101827;
    }

    .app-screen {
      padding: 25px 18px;
    }

    .app-title {
      font-size: 23px;
      font-weight: bold;
      color: #0757c9;
      margin-bottom: 20px;
    }

    .balance {
      background: #0757c9;
      color: white;
      border-radius: 20px;
      padding: 22px;
      margin-bottom: 20px;
    }

    .balance small {
      opacity: 0.8;
    }

    .balance h2 {
      margin-top: 5px;
      font-size: 30px;
    }

    .app-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .action {
      padding: 18px 8px;
      text-align: center;
      border-radius: 15px;
      background: #eef5ff;
      color: #0757c9;
      font-weight: bold;
    }

    /* GENERAL */
    section {
      padding: 90px 25px;
    }

    .container {
      max-width: 1100px;
      margin: auto;
    }

    .section-title {
      text-align: center;
      margin-bottom: 55px;
    }

    .section-title h2 {
      font-size: 40px;
      color: #10254d;
      margin-bottom: 12px;
    }

    .section-title p {
      color: #697586;
      max-width: 650px;
      margin: auto;
    }

    /* ABOUT */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
    }

    .about-text h3 {
      font-size: 30px;
      margin-bottom: 18px;
      color: #10254d;
    }

    .about-text p {
      color: #657083;
      margin-bottom: 15px;
    }

    .about-box {
      background: #0757c9;
      color: white;
      padding: 45px;
      border-radius: 30px;
      box-shadow: 0 20px 40px rgba(7,87,201,0.2);
    }

    .about-box h3 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    /* FEATURES */
    .features {
      background: #f6f9fd;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .feature {
      background: white;
      padding: 30px 22px;
      border-radius: 22px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.06);
      transition: 0.3s;
    }

    .feature:hover {
      transform: translateY(-7px);
    }

    .feature-icon {
      width: 55px;
      height: 55px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: #e9f2ff;
      color: #0757c9;
      font-size: 25px;
      margin-bottom: 20px;
    }

    .feature h3 {
      margin-bottom: 10px;
      color: #172033;
    }

    .feature p {
      color: #6b7585;
      font-size: 15px;
    }

    /* HOW IT WORKS */
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .step {
      text-align: center;
      padding: 30px;
    }

    .number {
      width: 60px;
      height: 60px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background: #0757c9;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: bold;
    }

    .step h3 {
      margin-bottom: 10px;
    }

    .step p {
      color: #697586;
    }

    /* CTA */
    .cta {
      background: linear-gradient(135deg, #0757c9, #0a3d91);
      color: white;
      text-align: center;
    }

    .cta h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .cta p {
      max-width: 650px;
      margin: 0 auto 30px;
      opacity: 0.9;
    }

    .cta .btn {
      background: white;
      color: #0757c9;
    }

    /* CONTACT */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .contact-info h3 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .contact-info p {
      color: #697586;
      margin-bottom: 20px;
    }

    .contact-item {
      margin-bottom: 15px;
      font-weight: 600;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    input,
    textarea {
      width: 100%;
      padding: 16px;
      border: 1px solid #d9e0ea;
      border-radius: 12px;
      font-family: inherit;
      outline: none;
    }

    input:focus,
    textarea:focus {
      border-color: #0757c9;
    }

    textarea {
      min-height: 140px;
      resize: vertical;
    }

    form button {
      border: none;
      cursor: pointer;
      font-size: 16px;
    }

    /* FOOTER */
    footer {
      background: #101827;
      color: white;
      padding: 45px 25px 25px;
    }

    .footer-container {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      gap: 30px;
      flex-wrap: wrap;
    }

    footer .logo {
      color: white;
    }

    .footer-links {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: #cbd5e1;
      text-decoration: none;
    }

    .copyright {
      max-width: 1100px;
      margin: 35px auto 0;
      padding-top: 20px;
      border-top: 1px solid #2d3748;
      color: #9ca8b8;
      font-size: 14px;
    }

    /* MOBILE */
    @media (max-width: 850px) {
      .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: white;
        flex-direction: column;
        padding: 25px;
        text-align: center;
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
      }

      .nav-links.active {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .hero-container,
      .about-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        text-align: center;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .buttons {
        justify-content: center;
      }

      .feature-grid {
        grid-template-columns: 1fr 1fr;
      }

      .phone-area {
        margin-top: 30px;
      }
    }

    @media (max-width: 550px) {
      .feature-grid,
      .steps {
        grid-template-columns: 1fr;
      }

      .section-title h2 {
        font-size: 32px;
      }

      .cta h2 {
        font-size: 32px;
      }

      .phone {
        width: 260px;
        height: 520px;
      }
    }
  </style>
</head>

<body>

